generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("MEMBER")
  avatar       Avatar?
  roomMembers  RoomMember[]
  messages     Message[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Avatar {
  id         String   @id @default(uuid())
  userId     String   @unique
  hair       String   @default("short")
  hairColor  String   @default("black")
  face       String   @default("default")
  skinColor  String   @default("medium")
  shirt      String   @default("basic")
  shirtColor String   @default("blue")
  pants      String   @default("basic")
  accessory  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Room {
  id          String       @id @default(uuid())
  name        String
  maxMembers  Int          @default(4)
  roomMembers RoomMember[]
  messages    Message[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RoomMember {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  positionX Int      @default(1)
  positionY Int      @default(1)
  status    String   @default("online")
  todayTask String?
  isOnline  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roomId], name: "userId_roomId")
}

model Message {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  content   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
